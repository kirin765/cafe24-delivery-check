# Cafe24 앱 연동 (Cafe24 관리자 [앱]에서 실행할 때)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=https://cafe24-delivery-check.vercel.app/api/cafe24/oauth/callback
CAFE24_SCOPES=mall.read_product

# 쿠키(토큰) 암호화 키 — openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# 선택
CAFE24_API_BASE=
CAFE24_TOKEN_UTC_OFFSET=+09:00
CAFE24_LAUNCH_MAX_AGE_SECONDS=1800
CAFE24_LAUNCH_ALLOW_UNVERIFIED=0

# 심사 제출 메일용 테스트 관리자 (커밋 금지)
TEST_ADMIN_ID=
TEST_ADMIN_PW=
TEST_MALL=onnurimun
